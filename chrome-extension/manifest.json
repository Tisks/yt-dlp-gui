{
  "manifest_version": 3,
  "name": "yt-dlp-gui URL Sender",
  "version": "1.0",
  "description": "Sends the current tab's URL to the local yt-dlp-gui app via a keyboard shortcut.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:5005/*"],
  "commands": {
    "send-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Send current tab URL to yt-dlp-gui"
    },
    "trigger-download": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Trigger Download in yt-dlp-gui"
    },
    "check-archive": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Check the Channel checkbox for the last pasted URL in yt-dlp-gui"
    }
  }
}
